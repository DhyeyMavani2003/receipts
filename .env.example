# Required for live extraction, grading and ask
OPENAI_API_KEY=
# Optional: pin models (otherwise picked from your account's model list)
RECEIPTS_MODEL=
RECEIPTS_GRADER_MODEL=
# openai (default) | replay (offline, uses fixtures/llm) 
RECEIPTS_LLM=openai
# Set to 1 to record every live model call into fixtures/llm for offline replay
RECEIPTS_RECORD=0
# GBrain: which brain Receipts writes to (an absolute path; ~ is not expanded
# here). Receipts passes it to every gbrain call. Raw `gbrain` run from THIS
# folder ignores a GBRAIN_HOME that a .env here assigns and falls back to
# ~/.gbrain, so run raw gbrain from another folder with GBRAIN_HOME exported.
# GBRAIN_HOME=/Users/you/receipts-brain
# GBRAIN_BIN=gbrain
