  "runbook_schema_version": 1,
  "eval_schema_version": 1,
  "skills": [
    "skills/receipts-ingest",
    "skills/receipts-grade",
    "skills/receipts-drift",
    "skills/receipts-ask"
  ],
  "runbooks": {
    "bootstrap": "runbooks/bootstrap.md"
  },
  "unit_tests": [
    "test/**/*.test.ts"
  ],
  "e2e_tests": [
